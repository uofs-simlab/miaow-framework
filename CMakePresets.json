{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default",
      "description": "Configure with compile_commands.json for IntelliSense",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "MIAOW_BOOST_PROVIDER": "auto",
        "MIAOW_JSON_PROVIDER": "auto",
        "MIAOW_CAF_PROVIDER": "auto",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    }
  ]
}
