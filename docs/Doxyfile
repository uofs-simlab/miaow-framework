PROJECT_NAME = "MIAOW"
PROJECT_BRIEF = "Model-independent actor orchestration workflows"

OUTPUT_DIRECTORY = docs/_build/doxygen
GENERATE_HTML = NO
GENERATE_LATEX = NO
GENERATE_XML = YES
XML_OUTPUT = xml

INPUT = include/miaow.hpp \
        include/miaow_bmi.hpp \
        include/miaow_io.hpp
RECURSIVE = NO
EXCLUDE_PATTERNS = */third_party/*
STRIP_FROM_PATH = .

EXTRACT_ALL = NO
EXTRACT_PRIVATE = NO
EXTRACT_STATIC = NO
HIDE_UNDOC_MEMBERS = YES
WARN_IF_UNDOCUMENTED = NO

FULL_PATH_NAMES = YES
SHOW_INCLUDE_FILES = NO
SOURCE_BROWSER = NO
REFERENCES_LINK_SOURCE = NO

QUIET = YES
WARN_AS_ERROR = NO
WARN_IF_DOC_ERROR = YES

ENABLE_PREPROCESSING = YES
MACRO_EXPANSION = NO
BUILTIN_STL_SUPPORT = YES
MARKDOWN_SUPPORT = YES
